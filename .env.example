# Copy this file to .env and fill in only what you need.
# Never commit .env. Never put a real wallet's key here.

# Optional: public testnet deployment (Sepolia). Use a throwaway test wallet only.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Comma-separated wallet addresses to receive roles on non-local networks
NGO_ADDRESSES=
AUDITOR_ADDRESSES=

# Optional: write the gas report to a file instead of the terminal
GAS_REPORT_FILE=

# Used by the backend (Phase 6)
PINATA_JWT=
